# Generated by Cargo
/target/
**/target/

# Cargo.lock is included for binaries, but not libraries
# Since this is a workspace with both, we include it
# Cargo.lock

# Backup files
*.bak
*~
__pycache__/
*.py[cod]

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.so
*.dylib
*.dll
*.a
*.lib
*.exe

# WebAssembly build output (root pkg dir)
pkg/

# Web project
web/node_modules/
web/.svelte-kit/
web/build/

# Keep WASM output in web/src/lib/wasm/
!web/src/lib/wasm/*.wasm
!web/src/lib/wasm/*.js
!web/src/lib/wasm/*.d.ts

# Generated output
output/
*.glb

# Coverage and profiling
*.profraw
*.profdata
coverage/
tarpaulin-report.html

# Documentation build
/doc/
target/doc/

# Benchmark results
criterion/

# Local configuration
.env
.env.local
*.local.toml

# Generated preset files (keep templates)
presets/generated/

# Node / desktop app
node_modules/
dist/
apps/desktop/node_modules/
