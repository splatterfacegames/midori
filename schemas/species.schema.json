{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midori.splatterfacegames.dev/schemas/species.schema.json",
  "title": "Midori Species",
  "description": "Species definition for Midori procedural tree generation. Written as TOML ([section] tables); this schema describes the equivalent JSON object model.",
  "type": "object",
  "required": [
    "species",
    "trunk"
  ],
  "additionalProperties": true,
  "properties": {
    "species": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Common name, e.g. Oak"
        },
        "scientific": {
          "type": "string",
          "description": "Scientific name, e.g. Quercus robur"
        },
        "latin": {
          "type": "string",
          "description": "Latin/binomial alias"
        },
        "biome": {
          "type": "string",
          "description": "Broad biome label (temperate, desert, tropical, ...)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "weber_penn",
            "dichotomous",
            "topiary",
            "floral_shrub",
            "climbing_vine",
            "tropical_clump",
            "rosette",
            "cactus",
            "pad_chain",
            "custom"
          ],
          "default": "weber_penn"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "trunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number",
          "default": 8.0,
          "description": "Base height in meters"
        },
        "height_variance": {
          "type": "number",
          "default": 0.0
        },
        "radius": {
          "type": "number",
          "default": 0.45,
          "description": "Base radius in meters"
        },
        "taper": {
          "type": "number",
          "default": 0.75,
          "description": "0 = cylinder, 1 = cone"
        },
        "taper_profile": {
          "$ref": "#/$defs/taper_profile",
          "default": "linear"
        },
        "curve": {
          "type": "number",
          "default": 0.0,
          "description": "Curvature in degrees"
        },
        "curve_variance": {
          "type": "number",
          "default": 0.0
        },
        "curve_back": {
          "type": "number",
          "default": 0.0,
          "description": "Back-curve (S-curve) amount"
        },
        "segments": {
          "type": "integer",
          "minimum": 0,
          "default": 8
        },
        "buttress": {
          "type": "number",
          "default": 1.0,
          "description": "Root-buttress flare, flutes and surface roots: 0 = plain column, 1 = built-in look, up to 3 = heavy buttresses",
          "minimum": 0,
          "maximum": 3
        },
        "char_height": {
          "type": "number",
          "default": 0.0,
          "description": "Height in meters of fire-blackened bark from the ground (needs canopy.vertex_color = tint_ao)",
          "minimum": 0
        },
        "char_strength": {
          "type": "number",
          "default": 0.85,
          "description": "How black the charred base is",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level1": {
          "$ref": "#/$defs/branch_params"
        },
        "level2": {
          "$ref": "#/$defs/branch_params"
        },
        "level3": {
          "$ref": "#/$defs/branch_params"
        }
      }
    },
    "crown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "spherical",
            "conical",
            "hemispherical",
            "flame",
            "columnar"
          ],
          "default": "spherical"
        },
        "offset": {
          "type": "number",
          "default": 0.35,
          "description": "Crown center as a fraction of tree height"
        },
        "density": {
          "type": "number",
          "default": 1.0
        },
        "width_ratio": {
          "type": "number",
          "default": 1.0
        }
      }
    },
    "leaves": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "default": 2000
        },
        "min_level": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "size": {
          "type": "number",
          "default": 0.12
        },
        "size_variance": {
          "type": "number",
          "default": 0.0
        },
        "distribution": {
          "type": "string",
          "enum": [
            "endpoint",
            "along_branch",
            "both"
          ],
          "default": "both"
        },
        "geometry": {
          "$ref": "#/$defs/leaf_geometry",
          "default": "cross_billboard"
        },
        "shape": {
          "$ref": "#/$defs/leaf_shape",
          "default": "pointed"
        },
        "up_influence": {
          "type": "number",
          "default": 0.0
        }
      }
    },
    "canopy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canopy shaping for top-down/distant foliage: clump normals, outward-facing canopy cards, crown fill, and baked tint+AO vertex colour.",
      "properties": {
        "normals": {
          "type": "string",
          "enum": [
            "geometric",
            "canopy"
          ],
          "default": "geometric"
        },
        "normal_blend": {
          "type": "number",
          "default": 0.85
        },
        "up_bias": {
          "type": "number",
          "default": 0.35
        },
        "clump_weight": {
          "type": "number",
          "default": 0.6
        },
        "clump_level": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "crown_fill": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "shell": {
          "type": "number",
          "default": 0.0
        },
        "card_tilt": {
          "type": "number",
          "default": 25.0
        },
        "card_max_angle": {
          "type": "number",
          "default": 90.0
        },
        "card_roll": {
          "type": "string",
          "enum": [
            "random",
            "radial"
          ],
          "default": "random"
        },
        "card_offset": {
          "type": "number",
          "default": 0.0
        },
        "single_sided": {
          "type": "boolean",
          "default": false
        },
        "vertex_color": {
          "type": "string",
          "enum": [
            "pivot_painter",
            "tint_ao"
          ],
          "default": "pivot_painter"
        },
        "tint_variation": {
          "type": "number",
          "default": 0.18
        },
        "hue_variation": {
          "type": "number",
          "default": 0.12
        },
        "ao_strength": {
          "type": "number",
          "default": 0.5
        },
        "lod_scale_compensation": {
          "type": "boolean",
          "default": true
        },
        "card_scale_by_clump": {
          "type": "number",
          "default": 0.0
        },
        "roughness": {
          "type": "number"
        }
      }
    },
    "textures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bark_prompt": {
          "type": "string",
          "description": "Authoring hint for bark map generation"
        },
        "leaf_prompt": {
          "type": "string",
          "description": "Authoring hint for leaf card generation"
        },
        "resolution": {
          "type": "integer",
          "minimum": 1,
          "default": 512,
          "description": "Generated map size, square, in pixels"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Map seed; derived from species name when unset"
        },
        "bark_style": {
          "type": "string",
          "enum": [
            "furrowed",
            "plated",
            "smooth",
            "stringy",
            "tessellated",
            "patchy",
            "papery"
          ],
          "default": "furrowed"
        },
        "leaf_shape": {
          "$ref": "#/$defs/leaf_shape",
          "default": "pointed"
        },
        "leaf_card": {
          "type": "string",
          "enum": [
            "single",
            "cluster",
            "puff",
            "dense",
            "frond",
            "buxus",
            "scale_cypress",
            "floral"
          ],
          "default": "cluster"
        },
        "bark_color": {
          "$ref": "#/$defs/rgb"
        },
        "leaf_color": {
          "$ref": "#/$defs/rgb"
        },
        "bark_patch_colors": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/rgb"
          },
          "description": "Extra bark colours: exposed patches (patchy), sheet-edge underlayers (papery)"
        },
        "bark_kino": {
          "type": "number",
          "default": 0.0,
          "description": "Amount of dark red gum (kino) bleeding down from bark cracks",
          "minimum": 0,
          "maximum": 1
        },
        "bark_albedo": {
          "type": "string",
          "description": "Host-provided bark albedo+alpha image path, relative to the species file"
        },
        "bark_normal": {
          "type": "string",
          "description": "Host-provided bark normal map (OpenGL +Y) path"
        },
        "leaf_albedo_alpha": {
          "type": "string",
          "description": "Host-provided leaf albedo+alpha card path"
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata-only material placeholders for external pipelines; not a texture contract.",
      "properties": {
        "bark": {
          "type": "string"
        },
        "foliage": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "control_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "parameter": {
                  "type": "string",
                  "description": "Dotted path to a species parameter"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "ultra",
            "high_quality",
            "balanced",
            "mobile",
            "minimal",
            "open_world",
            "hero_tree",
            "custom"
          ],
          "default": "balanced"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "target_triangles"
            ],
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              },
              "target_triangles": {
                "type": "integer",
                "minimum": 0
              },
              "max_triangles": {
                "type": "integer",
                "minimum": 0
              },
              "branch_levels": {
                "type": "integer",
                "minimum": 0,
                "default": 4
              },
              "leaf_geometry": {
                "$ref": "#/$defs/leaf_geometry",
                "default": "cross_billboard"
              },
              "leaf_reduction": {
                "type": "number",
                "default": 1.0
              },
              "ring_resolution": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "[trunk, level1, level2, level3] radial segment counts"
              },
              "screen_height": {
                "type": "number",
                "default": 0.0
              },
              "crown_impostor": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "modern_pc",
            "mobile",
            "switch",
            "quest",
            "web",
            "universal"
          ],
          "default": "modern_pc"
        }
      }
    },
    "topiary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "box",
            "bent_box",
            "sphere",
            "cylinder",
            "cone"
          ],
          "default": "box"
        },
        "length": {
          "type": "number",
          "default": 2.4
        },
        "width": {
          "type": "number",
          "default": 0.68
        },
        "height": {
          "type": "number",
          "default": 1.05
        },
        "bevel": {
          "type": "number",
          "default": 0.11
        },
        "bend_angle": {
          "type": "number",
          "default": 90.0
        },
        "trim_tightness": {
          "type": "number",
          "default": 0.80
        },
        "skirt_clearance": {
          "type": "number",
          "default": 0.06
        }
      }
    },
    "floral": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "habit": {
          "type": "string",
          "enum": [
            "mound",
            "trough",
            "cascade"
          ],
          "default": "mound"
        },
        "length": {
          "type": "number",
          "default": 0.72
        },
        "width": {
          "type": "number",
          "default": 0.72
        },
        "height": {
          "type": "number",
          "default": 0.46
        },
        "cascade_drop": {
          "type": "number",
          "default": 1.35
        },
        "blossom_density": {
          "type": "number",
          "default": 0.68
        }
      }
    },
    "vine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "default": 2.8
        },
        "height": {
          "type": "number",
          "default": 4.2
        },
        "depth": {
          "type": "number",
          "default": 0.46
        },
        "main_vines": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "hanging_runners": {
          "type": "integer",
          "minimum": 0,
          "default": 8
        }
      }
    },
    "rosette": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rosette plants (generator.family = rosette): crowns of long blades on an optional trunk. See docs/botanical-generators.md",
      "properties": {
        "crowns": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of crowns; more than one forks the trunk"
        },
        "fork_height": {
          "type": "number",
          "default": 0.55,
          "description": "Fraction of trunk height where the arms leave",
          "minimum": 0,
          "maximum": 1
        },
        "fork_angle": {
          "type": "number",
          "default": 32.0,
          "description": "Degrees between an arm and the trunk axis",
          "minimum": 0,
          "maximum": 90
        },
        "blades": {
          "type": "integer",
          "minimum": 1,
          "default": 240,
          "description": "Live blades per crown"
        },
        "blade_length": {
          "type": "number",
          "default": 1.0,
          "description": "Blade length in meters"
        },
        "blade_length_variance": {
          "type": "number",
          "default": 0.15,
          "minimum": 0,
          "maximum": 1
        },
        "blade_width": {
          "type": "number",
          "default": 0.03,
          "description": "Ribbon width in meters"
        },
        "blade_card": {
          "type": "string",
          "enum": [
            "single",
            "tuft",
            "pinnate"
          ],
          "default": "tuft"
        },
        "spread_min": {
          "type": "number",
          "default": 5.0,
          "description": "Degrees from the crown axis for the youngest blades",
          "minimum": 0,
          "maximum": 180
        },
        "spread_max": {
          "type": "number",
          "default": 120.0,
          "description": "Degrees from the crown axis for the oldest blades",
          "minimum": 0,
          "maximum": 180
        },
        "droop": {
          "type": "number",
          "default": 0.35,
          "description": "Arching under gravity",
          "minimum": 0,
          "maximum": 1
        },
        "stiffness": {
          "type": "number",
          "default": 0.7,
          "description": "Blade rigidity; also the Pivot Painter stiffness",
          "minimum": 0,
          "maximum": 1
        },
        "keel": {
          "type": "number",
          "default": 0.2,
          "description": "V fold along the midrib",
          "minimum": 0,
          "maximum": 1
        },
        "color_base": {
          "$ref": "#/$defs/rgb",
          "description": "Blade colour at the base"
        },
        "color_tip": {
          "$ref": "#/$defs/rgb",
          "description": "Blade colour at the tip"
        },
        "skirt": {
          "type": "number",
          "default": 0.0,
          "description": "Fraction of the stem below each crown clothed in dead blades",
          "minimum": 0,
          "maximum": 1
        },
        "skirt_blades": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Dead blades per crown"
        },
        "skirt_color": {
          "$ref": "#/$defs/rgb",
          "description": "Dead blade colour"
        },
        "spike": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chance": {
              "type": "number",
              "default": 1.0,
              "description": "Probability that a spike appears",
              "minimum": 0,
              "maximum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Spikes attempted per crown"
            },
            "style": {
              "type": "string",
              "enum": [
                "cylinder",
                "raceme",
                "cone"
              ],
              "default": "cylinder"
            },
            "scape_length": {
              "type": "number",
              "default": 0.9,
              "description": "Bare stalk length in meters",
              "minimum": 0
            },
            "scape_radius": {
              "type": "number",
              "default": 0.012
            },
            "length": {
              "type": "number",
              "default": 1.2,
              "description": "Length of the flowering part or cone in meters"
            },
            "radius": {
              "type": "number",
              "default": 0.025
            },
            "lean": {
              "type": "number",
              "default": 8.0,
              "description": "Maximum lean from the crown axis in degrees",
              "minimum": 0,
              "maximum": 90
            },
            "color": {
              "$ref": "#/$defs/rgb"
            },
            "tip_color": {
              "$ref": "#/$defs/rgb"
            },
            "scape_color": {
              "$ref": "#/$defs/rgb"
            },
            "flowers": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "raceme: tubular flowers at the top of the scape"
            },
            "flower_length": {
              "type": "number",
              "default": 0.08
            }
          }
        }
      }
    },
    "inflorescence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inflorescence / fruit organs on a branching tree. See docs/botanical-generators.md",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "spike",
            "nut",
            "cluster",
            "berries"
          ],
          "default": "spike"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "default": 40,
          "description": "Organs on the whole tree"
        },
        "min_level": {
          "type": "integer",
          "minimum": 0,
          "default": 2,
          "description": "Only stems at or beyond this branch level carry organs"
        },
        "placement": {
          "type": "string",
          "enum": [
            "endpoint",
            "along_branch"
          ],
          "default": "endpoint"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "up",
            "branch",
            "hang"
          ],
          "default": "up"
        },
        "length": {
          "type": "number",
          "default": 0.2,
          "description": "Length in meters (card size for clusters and berries)"
        },
        "width": {
          "type": "number",
          "default": 0.08,
          "description": "Diameter in meters (spike, nut)"
        },
        "size_variance": {
          "type": "number",
          "default": 0.0,
          "minimum": 0,
          "maximum": 1
        },
        "offset": {
          "type": "number",
          "default": 0.0,
          "description": "Meters between the attachment point and the organ base, along its axis",
          "minimum": 0
        },
        "color": {
          "$ref": "#/$defs/rgb",
          "description": "Fresh colour"
        },
        "color_tip": {
          "$ref": "#/$defs/rgb",
          "description": "Colour toward the tip or centre"
        },
        "aged_fraction": {
          "type": "number",
          "default": 0.0,
          "description": "Share of organs drawn as aged",
          "minimum": 0,
          "maximum": 1
        },
        "aged_color": {
          "$ref": "#/$defs/rgb",
          "description": "Aged colour: old cones, spent flowers, pods"
        }
      }
    },
    "states": {
      "type": "object",
      "description": "Named overlays ([states.<name>]) deep-merged onto the document by --state / Species::from_toml_with_state. Each value may set any species parameter.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "taper_profile": {
      "type": "string",
      "enum": [
        "linear",
        "smooth",
        "exponential",
        "compound"
      ]
    },
    "leaf_geometry": {
      "type": "string",
      "enum": [
        "polygon",
        "cross_billboard",
        "billboard",
        "canopy_card",
        "none"
      ]
    },
    "leaf_shape": {
      "type": "string",
      "enum": [
        "oval",
        "pointed",
        "needle",
        "oak_lobed",
        "lobed",
        "maple",
        "serrated",
        "willow",
        "heart",
        "palmate",
        "ginkgo",
