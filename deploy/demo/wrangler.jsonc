{
  // Owner-only demo of the browser workbench at midori.splatterfacegames.com.
  // Deployed by .github/workflows/demo.yml from master; see deploy/demo/README.md.
  "name": "midori-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "midori.splatterfacegames.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCESS_ISSUER": "https://jethachan.cloudflareaccess.com",
    "ACCESS_AUD": "b3ab9aee3471a6a0616f59866924259c3c951919bb06d7837ef64e944468f0df"
  }
}
