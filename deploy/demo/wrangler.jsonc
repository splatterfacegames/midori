{
  // Public product site + interactive browser workbench at midori.splatterfacegames.com.
  // Deployed by .github/workflows/demo.yml from master; see deploy/demo/README.md.
  "name": "midori-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist-site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "midori.splatterfacegames.com",
      "custom_domain": true
    }
  ]
}
