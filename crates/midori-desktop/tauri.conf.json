{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Midori",
  "version": "0.1.0",
  "identifier": "com.splatterfacegames.midori",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Midori",
        "width": 1440,
        "height": 940,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Procedural tree generator workbench"
  }
}
