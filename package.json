{
  "name": "midori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Midori — procedural tree generator workbench and engine",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm": "node scripts/build-wasm.mjs",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build"
  },
  "dependencies": {
    "@jethac/tools-frontend-stack": "git+https://github.com/splatterfacegames/jethaforge.git#304d283815d831be4458178fa8918c33703b4323",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
